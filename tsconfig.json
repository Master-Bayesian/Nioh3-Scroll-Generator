{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "jsx": "react-jsx", "esModuleInterop": true,
    "resolveJsonModule": true, "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["apps/desktop/**/*.ts", "apps/desktop/**/*.tsx", "apps/workshop/**/*.ts", "apps/workshop/**/*.tsx", "packages/contracts/**/*.ts"]
}
