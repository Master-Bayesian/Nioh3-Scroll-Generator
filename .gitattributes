* text=auto

*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
packages/contracts/*.ts text eol=lf
*.ps1 text eol=crlf

# Native build identities hash the exact source bytes on every checkout.
*.cu text eol=lf
*.cpp text eol=lf
*.h text eol=lf

# Capture provenance pins this CE source file's exact bytes.
research/owned_breakpoint_lifecycle_ce.lua text eol=lf

*.bin binary
*.dll binary
*.exe binary
*.png binary

# Preserve downloaded third-party notices byte-for-byte for provenance hashes.
third_party/rust-notices/** -text
third_party/rust-notices/**/provenance.json text eol=lf

# Frozen evidence fixtures retain their captured byte identity.
tests/fixtures/m23c-application/catalog_reference_zh.json -text whitespace=cr-at-eol
tests/fixtures/game-version-update-20260919/reports/resource-comparison-v2.02-ng3.json -text whitespace=cr-at-eol
